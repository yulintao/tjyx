/* 实景叠盘：cover-view 只能使用有限样式，避免复杂布局 */
.hud-back {
  position: fixed;
  width: 150rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #e9d8a6;
  background-color: rgba(10, 13, 20, 0.62);
}
.hud-top {
  position: fixed;
  left: 40rpx;
  top: 80rpx;
  padding: 16rpx 24rpx;
  background-color: rgba(10, 13, 20, 0.55);
  border-radius: 16rpx;
  color: #e9d8a6;
}
.hud-heading {
  font-size: 44rpx;
  font-weight: bold;
  color: #e9d8a6;
}
.hud-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #cfd8ea;
}

.cross {
  position: fixed;
  background-color: #e9d8a6;
}
.cross-h {
  left: 50%;
  top: 50%;
  margin-left: -60rpx;
  margin-top: -2rpx;
  width: 120rpx;
  height: 4rpx;
}
.cross-v {
  left: 50%;
  top: 50%;
  margin-left: -2rpx;
  margin-top: -60rpx;
  width: 4rpx;
  height: 120rpx;
}
.cross-ring {
  left: 50%;
  top: 50%;
  margin-left: -24rpx;
  margin-top: -24rpx;
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #e9d8a6;
  border-radius: 50%;
  background-color: rgba(0, 0, 0, 0);
}

.bubble-box {
  position: fixed;
  right: 40rpx;
  top: 50%;
  margin-top: -100rpx;
  width: 200rpx;
  height: 200rpx;
  border: 2rpx solid rgba(233, 216, 166, 0.6);
  border-radius: 50%;
  background-color: rgba(10, 13, 20, 0.35);
}
.bubble-dot {
  position: absolute;
  width: 32rpx;
  height: 32rpx;
  margin-left: -16rpx;
  margin-top: -16rpx;
  background-color: #7fd3a0;
  border-radius: 50%;
}

.hud-bottom {
  position: fixed;
  left: 40rpx;
  right: 40rpx;
  bottom: 60rpx;
  height: 272rpx;
  padding: 20rpx;
  background-color: rgba(10, 13, 20, 0.55);
  border-radius: 20rpx;
}
.hud-tip {
  font-size: 24rpx;
  color: #cfd8ea;
  text-align: center;
}
/* 第一行：实景测距（起点 / 终点 / 结束），独占一行 */
.hud-vk {
  position: absolute;
  top: 82rpx;
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  font-size: 26rpx;
  color: #1a1f2b;
  background-color: #7fd3a0;
  border-radius: 12rpx;
}
.hud-vk-entry { left: 16rpx; width: 300rpx; }
.hud-vk-start { left: 16rpx; width: 190rpx; }
.hud-vk-end { left: 220rpx; width: 190rpx; }
.hud-vk-stop { right: 16rpx; width: 190rpx; color: #cfd8ea; background-color: rgba(120, 140, 180, 0.3); }
/* 第二行：拍照存证 / 校北 / 清校 */
.hud-btn {
  position: absolute;
  top: 172rpx;
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  font-size: 26rpx;
  color: #1a1f2b;
  background-color: #e9d8a6;
  border-radius: 12rpx;
}
.hud-btn-2 {
  left: 16rpx;
  width: 300rpx;
}
.hud-btn-3 {
  left: 330rpx;
  width: 140rpx;
  color: #cfd8ea;
  background-color: rgba(120, 140, 180, 0.3);
}
.hud-btn-4 {
  right: 16rpx;
  width: 140rpx;
  color: #cfd8ea;
  background-color: rgba(120, 140, 180, 0.3);
}

.snap-overlay {
  position: fixed;
  left: 0;
  top: 0;
  width: 100vw;
  height: 100vh;
  background: #0b0d13;
  display: flex;
  flex-direction: column;
}
.snap-img {
  flex: 1;
  width: 100%;
}
.snap-actions {
  display: flex;
  padding: 24rpx 28rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  gap: 16rpx;
}
.snap-actions .btn {
  flex: 1;
}

/* 点画面取方位 */
.pick-layer {
  position: fixed;
  left: 0;
  top: 0;
  width: 100vw;
  height: 100vh;
  background: transparent;
}
.pick-mark {
  position: fixed;
  top: 45%;
  width: 2rpx;
  height: 120rpx;
  margin-left: -1rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.pick-mark-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #e9d8a6;
  box-shadow: 0 0 12rpx rgba(233, 216, 166, 0.8);
}
.pick-mark-line {
  width: 2rpx;
  height: 90rpx;
  background: linear-gradient(to bottom, rgba(233,216,166,0.9), rgba(233,216,166,0));
}
.pick-card {
  position: fixed;
  left: 40rpx;
  right: 40rpx;
  bottom: 350rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: rgba(12, 18, 30, 0.92);
  border: 1rpx solid rgba(201, 162, 74, 0.45);
}
.pick-head {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}
.pick-title { font-size: 26rpx; color: #e9d8a6; }
.pick-close { font-size: 30rpx; color: #9fb0cb; padding: 0 10rpx; }
.pick-row { font-size: 22rpx; color: #cfd8e6; margin-top: 8rpx; line-height: 34rpx; }
.pick-ok { color: #7fd3a0; }
.pick-warn { color: #e8a87c; }
.pick-note { color: #9fb0cb; font-size: 20rpx; }
.pick-actions {
  display: flex;
  flex-direction: row;
  justify-content: flex-end;
  margin-top: 12rpx;
}
.pick-step {
  font-size: 22rpx;
  color: #e9d8a6;
  border: 1rpx solid rgba(201, 162, 74, 0.5);
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
  margin-left: 16rpx;
}
/* 稳持锁定徽标 */
.lock-badge {
  margin-top: 10rpx;
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(201, 162, 74, 0.22);
  border: 1rpx solid rgba(201, 162, 74, 0.6);
  color: #e9d8a6;
  font-size: 19rpx;
}