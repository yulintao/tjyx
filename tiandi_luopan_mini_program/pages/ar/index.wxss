/* 实景叠盘：cover-view 只能使用有限样式，避免复杂布局 */
.hud-back {
  position: fixed;
  width: 156rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 32rpx;
  font-size: 25rpx;
  font-weight: bold;
  color: #f2dfb0;
  background-color: rgba(11, 14, 22, 0.72);
  border: 1rpx solid rgba(233, 216, 166, 0.35);
}
.hud-top {
  position: fixed;
  left: 40rpx;
  top: 80rpx;
  padding: 18rpx 26rpx;
  background-color: rgba(11, 14, 22, 0.72);
  border: 1rpx solid rgba(233, 216, 166, 0.3);
  border-radius: 20rpx;
  color: #f2dfb0;
}
.hud-heading {
  font-size: 46rpx;
  font-weight: bold;
  color: #f6e7be;
}
.hud-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #d3dced;
}

.cross {
  position: fixed;
  background-color: #f2dfb0;
}
.cross-h {
  left: 50%;
  top: 50%;
  margin-left: -60rpx;
  margin-top: -2rpx;
  width: 120rpx;
  height: 4rpx;
}
.cross-v {
  left: 50%;
  top: 50%;
  margin-left: -2rpx;
  margin-top: -60rpx;
  width: 4rpx;
  height: 120rpx;
}
.cross-ring {
  left: 50%;
  top: 50%;
  margin-left: -26rpx;
  margin-top: -26rpx;
  width: 52rpx;
  height: 52rpx;
  border: 4rpx solid #f2dfb0;
  border-radius: 50%;
  background-color: rgba(0, 0, 0, 0);
}

.bubble-box {
  position: fixed;
  right: 40rpx;
  top: 50%;
  margin-top: -100rpx;
  width: 200rpx;
  height: 200rpx;
  border: 2rpx solid rgba(233, 216, 166, 0.65);
  border-radius: 50%;
  background-color: rgba(11, 14, 22, 0.45);
}
.bubble-dot {
  position: absolute;
  width: 32rpx;
  height: 32rpx;
  margin-left: -16rpx;
  margin-top: -16rpx;
  background-color: #5eead4;
  border-radius: 50%;
}

.hud-bottom {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: 52rpx;
  height: 278rpx;
  padding: 20rpx;
  background-color: rgba(11, 14, 22, 0.78);
  border: 1rpx solid rgba(233, 216, 166, 0.25);
  border-radius: 24rpx;
}
.hud-tip {
  font-size: 24rpx;
  color: #d7e0ef;
  text-align: center;
}
/* 第一行：实景测距（起点 / 终点 / 结束），独占一行 */
.hud-vk {
  position: absolute;
  top: 84rpx;
  height: 70rpx;
  line-height: 70rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: bold;
  color: #11161f;
  background-color: #6ee7b7;
  border-radius: 16rpx;
}
.hud-vk-entry { left: 18rpx; width: 310rpx; }
.hud-vk-start { left: 18rpx; width: 196rpx; }
.hud-vk-end { left: 228rpx; width: 196rpx; }
.hud-vk-stop { right: 18rpx; width: 196rpx; color: #d7e0ef; background-color: rgba(70, 84, 112, 0.55); border: 1rpx solid rgba(130, 152, 196, 0.35); }
/* 第二行：拍照存证 / 校北 / 清校 */
.hud-btn {
  position: absolute;
  top: 174rpx;
  height: 70rpx;
  line-height: 70rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: bold;
  color: #16181f;
  background-color: #e6c677;
  border-radius: 16rpx;
}
.hud-btn-2 {
  left: 18rpx;
  width: 310rpx;
}
.hud-btn-3 {
  left: 344rpx;
  width: 146rpx;
  color: #d7e0ef;
  background-color: rgba(70, 84, 112, 0.55);
  border: 1rpx solid rgba(130, 152, 196, 0.35);
}
.hud-btn-4 {
  right: 18rpx;
  width: 146rpx;
  color: #d7e0ef;
  background-color: rgba(70, 84, 112, 0.55);
  border: 1rpx solid rgba(130, 152, 196, 0.35);
}

.snap-overlay {
  position: fixed;
  left: 0;
  top: 0;
  width: 100vw;
  height: 100vh;
  background: #0b0d14;
  display: flex;
  flex-direction: column;
}
.snap-img {
  flex: 1;
  width: 100%;
}
.snap-actions {
  display: flex;
  padding: 24rpx 28rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  gap: 16rpx;
}
.snap-actions .btn {
  flex: 1;
}

/* 点画面取方位 */
.pick-layer {
  position: fixed;
  left: 0;
  top: 0;
  width: 100vw;
  height: 100vh;
  background: transparent;
}
.pick-mark {
  position: fixed;
  top: 45%;
  width: 2rpx;
  height: 120rpx;
  margin-left: -1rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.pick-mark-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: #f2dfb0;
}
.pick-mark-line {
  width: 2rpx;
  height: 90rpx;
  background-color: rgba(233, 216, 166, 0.85);
}
.pick-card {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: 354rpx;
  padding: 22rpx 24rpx;
  border-radius: 22rpx;
  background-color: rgba(12, 17, 29, 0.92);
  border: 1rpx solid rgba(233, 216, 166, 0.45);
}
.pick-head {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}
.pick-title { font-size: 27rpx; font-weight: bold; color: #f2dfb0; }
.pick-close { font-size: 30rpx; color: #9fb0cb; padding: 0 10rpx; }
.pick-row { font-size: 22rpx; color: #d3dced; margin-top: 8rpx; line-height: 34rpx; }
.pick-ok { color: #84dba6; }
.pick-warn { color: #f0a87c; }
.pick-note { color: #9fb0cb; font-size: 20rpx; }
.pick-actions {
  display: flex;
  flex-direction: row;
  justify-content: flex-end;
  margin-top: 12rpx;
}
.pick-step {
  font-size: 22rpx;
  color: #f2dfb0;
  border: 1rpx solid rgba(233, 216, 166, 0.5);
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
  margin-left: 16rpx;
  background-color: rgba(233, 216, 166, 0.1);
}
/* 稳持锁定徽标 */
.lock-badge {
  margin-top: 10rpx;
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background-color: rgba(201, 162, 74, 0.25);
  border: 1rpx solid rgba(233, 216, 166, 0.6);
  color: #f2dfb0;
  font-size: 20rpx;
}
/* 水平罗盘刻度带 */
.ribbon {
  position: fixed;
  left: 0;
  width: 100vw;
  height: 64rpx;
}
.ribbon-item {
  position: absolute;
  top: 0;
  width: 64rpx;
  margin-left: -32rpx;
  text-align: center;
  font-size: 28rpx;
  color: rgba(215, 224, 239, 0.75);
}
.ribbon-item.ribbon-active {
  color: #f2dfb0;
  font-weight: bold;
  font-size: 34rpx;
}
.ribbon-item.ribbon-tick {
  top: 4rpx;
  width: 2rpx;
  height: 16rpx;
  margin-left: -1rpx;
  background-color: rgba(215, 224, 239, 0.45);
}
.ribbon-center {
  position: absolute;
  left: 50%;
  top: 34rpx;
  width: 2rpx;
  height: 22rpx;
  margin-left: -1rpx;
  background-color: #f2dfb0;
}
