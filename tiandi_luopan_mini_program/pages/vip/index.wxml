<view class="screen">
  <view class="topbar">
    <view class="topbar-back" bindtap="back">←</view>
    <view class="topbar-title">功能权益</view>
    <view class="topbar-right"></view>
  </view>

  <view class="body">
    <view class="conclusion">
      <view class="conclusion-eyebrow">小程序权益对照</view>
      <view class="conclusion-head">本版全部功能已开放</view>
      <view class="conclusion-sub">原 iOS 版付费墙模块在小程序端已全部解锁，零内购门槛。</view>
      <view class="conclusion-note">本页仅作功能对照，不涉及任何购买行为；所有推算在本地完成。</view>
    </view>

    <view class="card" wx:for="{{benefits}}" wx:key="name">
      <view class="list-main">
        <text>{{item.name}}</text>
        <text class="tag tag-ji">开放</text>
      </view>
      <view class="list-desc">iOS：{{item.ios}}</view>
      <view class="list-desc" style="color:#84dba6;">本版：{{item.now}}</view>
    </view>

    <view class="card">
      <view class="card-title">数据与账号</view>
      <view class="row"><view class="row-k">当前版本</view><view class="row-v">{{version}}</view></view>
      <view class="row"><view class="row-k">云开发环境</view><view class="row-v">{{cloudEnv ? cloudEnv : '未配置'}}</view></view>
      <view class="btn btn-primary" style="margin-top:16rpx;" bindtap="goBackup">备份与恢复</view>
      <view class="btn" style="margin-top:12rpx;" bindtap="goRemedy">打开化解清单</view>
      <view class="btn btn-danger" style="margin-top:12rpx;" bindtap="onClear">清除本机数据</view>
    </view>
  </view>
</view>
