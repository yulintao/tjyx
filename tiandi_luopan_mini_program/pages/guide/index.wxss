/* pages/guide/index.wxss */

.guide-hero {
  margin-bottom: 22rpx;
}

.guide-step-pill {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(201, 162, 74, 0.18);
  border: 1rpx solid rgba(233, 216, 166, 0.34);
  color: #f0dfa8;
  font-size: 20rpx;
  letter-spacing: 2rpx;
  margin-bottom: 14rpx;
}

.guide-body-text {
  font-size: 27rpx;
  line-height: 44rpx;
  color: #e6ebf4;
}

.guide-tip-box {
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  background: rgba(11, 14, 22, 0.65);
  border-left: 5rpx solid #d4af37;
  border-radius: 0 14rpx 14rpx 0;
  font-size: 23rpx;
  line-height: 38rpx;
  color: #b4c2d9;
}

.guide-actions {
  display: flex;
  gap: 16rpx;
}

.guide-actions .btn {
  margin-top: 0;
}
