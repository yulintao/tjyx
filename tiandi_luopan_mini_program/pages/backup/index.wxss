/* pages/backup/index.wxss */

.input-box {
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  background: rgba(11, 14, 22, 0.92);
  border: 1rpx solid rgba(212, 175, 55, 0.24);
  color: #f0dfa8;
  font-size: 24rpx;
}

.btn-inline {
  display: inline-block;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(130, 152, 196, 0.22);
  font-size: 22rpx;
  font-weight: 500;
}

.btn-inline:active {
  opacity: 0.78;
}
