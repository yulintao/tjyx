/* pages/family/index.wxss */

.member-card {
  background: rgba(12, 15, 24, 0.65);
  border: 1rpx solid rgba(130, 152, 196, 0.16);
  border-radius: 16rpx;
  padding: 20rpx 18rpx;
  margin-bottom: 16rpx;
}

.member-card:last-child {
  margin-bottom: 0;
}

.member-inputs {
  display: flex;
  gap: 12rpx;
  margin-top: 14rpx;
  align-items: center;
}

.member-inputs .input-box {
  min-width: 0;
  flex: 1;
  padding: 10rpx 12rpx;
  font-size: 24rpx;
}

.member-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
}

.member-actions .btn {
  flex: 1;
  height: 68rpx;
  line-height: 68rpx;
  margin-top: 0;
  font-size: 23rpx;
}
