<view class="screen">
  <view class="topbar">
    <view class="topbar-back" bindtap="back">←</view>
    <view class="topbar-title">鲁班门光尺</view>
    <view class="topbar-right"></view>
  </view>

  <view class="body">
    <view class="card">
      <view class="card-title">实测尺寸</view>
      <view class="input-row">
        <label>宽度（厘米）</label>
        <input class="input-box" type="digit" value="{{cmInput}}" bindinput="onInput" placeholder="如 90" />
      </view>
      <slider min="0" max="300" value="{{cmInput}}" activeColor="#e9d8a6" block-size="20" bindchange="onSlider" bindchanging="onSlider" style="margin-top:8rpx;" />
      <view style="display:flex;flex-wrap:wrap;gap:12rpx;margin-top:12rpx;">
        <view class="btn" wx:for="{{presets}}" wx:key="label" data-cm="{{item.cm}}" bindtap="onPreset" style="flex:0 0 auto;padding:10rpx 18rpx;">{{item.label}}</view>
      </view>
      <view class="footnote">iOS 版用 AR 打点量取门窗实际宽度后即时判定；小程序无 AR 测距，改为此处输入卷尺实测值，判定口径与 iOS 一致（门光尺 42.9cm 八格、丁兰尺 39.0cm 十格）。</view>
    </view>

    <view class="card" wx:if="{{result}}">
      <view class="card-title">评定结果</view>
      <view class="row"><text class="row-k">实测</text><text class="row-v">{{result.cmText}}</text></view>
      <view class="row">
        <text class="row-k">门光尺（阳宅）</text>
        <text class="row-v">{{result.yangName}} · {{result.yangTag}}</text>
      </view>
      <view class="list-desc">{{result.yangMeaning}}</view>
      <view class="row">
        <text class="row-k">丁兰尺（阴宅）</text>
        <text class="row-v">{{result.yinName}} · {{result.yinTag}}</text>
      </view>
      <view class="list-desc">{{result.yinMeaning}}</view>
      <view class="row" wx:if="{{nearest}}">
        <text class="row-k">最近吉度</text>
        <text class="row-v">{{nearest.name}} · {{nearest.cm}} cm（差 {{nearest.diff}} cm）</text>
      </view>
      <view class="btn" wx:if="{{nearest}}" style="margin-top:12rpx;" bindtap="applyNearest">改取最近吉度 {{nearest.cm}} cm</view>
      <view class="btn" style="margin-top:16rpx;" bindtap="copyResult">复制结论到剪贴板</view>
      <view class="footnote">{{source}}</view>
    </view>

    <view class="card">
      <view class="card-title">门光尺八格（42.9cm 一循环）</view>
      <view class="row" wx:for="{{yangScale}}" wx:key="name" style="{{item.active ? 'background:rgba(233,216,166,0.10);border-radius:8rpx;' : ''}}">
        <text class="row-k">{{item.name}} · {{item.auspicious ? '吉' : '凶'}}</text>
        <text class="row-v">{{item.from}}–{{item.to}} cm{{item.active ? ' ← 当前' : ''}}</text>
      </view>
      <view class="card-sub">其余循环按 42.9cm 递推；取门框中到框中实测净宽。</view>
    </view>

    <view class="card">
      <view class="card-title">丁兰尺十格（39.0cm 一循环）</view>
      <view class="row" wx:for="{{yinScale}}" wx:key="name" style="{{item.active ? 'background:rgba(233,216,166,0.10);border-radius:8rpx;' : ''}}">
        <text class="row-k">{{item.name}} · {{item.auspicious ? '吉' : '凶'}}</text>
        <text class="row-v">{{item.from}}–{{item.to}} cm{{item.active ? ' ← 当前' : ''}}</text>
      </view>
      <view class="card-sub">丁兰尺多用于阴宅、神龛、牌位；阳宅门窗以门光尺为主。</view>
    </view>
  </view>
</view>
