<view class="screen">
  <view class="topbar">
    <view class="topbar-back" bindtap="back">←</view>
    <view class="topbar-title">今日日签</view>
    <view class="topbar-right"></view>
  </view>

  <view class="body">
    <ctx-bar />

    <!-- ============ 日课总览结论卡 ============ -->
    <view class="conclusion">
      <view class="conclusion-eyebrow">日课金签 · {{dateText}} 星期{{weekText}}</view>
      <view class="conclusion-head">{{jianChu}}日 · {{godName}}值日</view>
      <view class="conclusion-sub">{{yearPillar}}年 {{monthPillar}}月 {{dayPillar}}日</view>
      <view class="conclusion-grid">
        <view class="conclusion-cell">
          <view class="conclusion-k">财神方位</view>
          <view class="conclusion-v gold">{{wealthDir}} {{wealthAngle}}°</view>
        </view>
        <view class="conclusion-cell">
          <view class="conclusion-k">喜神方位</view>
          <view class="conclusion-v ji" style="color:#5eead4;">{{joyDir}} {{joyAngle}}°</view>
        </view>
        <view class="conclusion-cell wide">
          <view class="conclusion-k">今日宜</view>
          <view class="conclusion-v ji" style="font-size:23rpx;line-height:34rpx;">{{yi}}</view>
        </view>
        <view class="conclusion-cell wide">
          <view class="conclusion-k">今日忌</view>
          <view class="conclusion-v xiong" style="font-size:23rpx;line-height:34rpx;">{{ji}}</view>
        </view>
        <view class="conclusion-cell wide" wx:if="{{chongText}}">
          <view class="conclusion-k">冲煞提示</view>
          <view class="conclusion-v xiong" style="font-size:22rpx;">{{chongText}}</view>
        </view>
      </view>
      <view class="row" wx:if="{{solarName}}" style="margin-top:12rpx;border-bottom:none;"><text class="row-k">节气</text><text class="row-v">当令「{{solarName}}」· {{nextTermText}}</text></view>
      <view class="term-bar" wx:if="{{solarName}}"><view class="term-bar-fill" style="width:{{termPercent}}%;"></view></view>
      <view class="conclusion-note" wx:if="{{officerText}}">{{officerText}}</view>
      <view class="list-desc" wx:for="{{warnings}}" wx:key="*this" style="color:#e8a87c;margin-top:6rpx;">{{item}}</view>
    </view>

    <view class="card">
      <view class="card-title">日签长图预览</view>
      <view class="canvas-frame">
        <canvas type="2d" id="dailyCardCanvas" style="width:100%;height:1334rpx;border-radius:16rpx;background:#0b0e15;display:block;"></canvas>
      </view>
      <view class="btn-row">
        <view class="btn btn-primary" bindtap="save">{{saved ? '✓ 已存相册' : '存入相册'}}</view>
        <view class="btn" bindtap="preview">查看大图</view>
      </view>
      <button class="btn" open-type="share" style="margin-top:14rpx;">分享给好友</button>
      <view class="btn" style="margin-top:14rpx;" bindtap="goZeri">查看完整择日</view>
      <view class="footnote">日签含干支四柱、建除宜忌、冲煞、财神喜神方位与吉时；分享卡片缩略图使用日签本身。</view>
    </view>
  </view>
</view>
