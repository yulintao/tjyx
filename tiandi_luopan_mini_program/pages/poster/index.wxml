<view class="screen">
  <view class="topbar">
    <view class="topbar-back" bindtap="back">←</view>
    <view class="topbar-title">分享海报</view>
    <view class="topbar-right"></view>
  </view>

  <view class="body">
    <view class="conclusion">
      <view class="conclusion-eyebrow">罗盘勘测 · 盘面摘要</view>
      <view class="conclusion-head">{{sit}}山{{face}}向 · {{heading}}°</view>
      <view class="conclusion-sub">{{period}}运 · 山星{{shan}} 向星{{xiang}}</view>
      <view class="conclusion-grid">
        <view class="conclusion-cell">
          <view class="conclusion-k">一百二十分金</view>
          <view class="conclusion-v gold" style="font-size:24rpx;">{{jiazi}} · {{grade}}</view>
        </view>
        <view class="conclusion-cell">
          <view class="conclusion-k">纳音五行</view>
          <view class="conclusion-v" style="font-size:24rpx;">{{nayin || '—'}}</view>
        </view>
        <view class="conclusion-cell wide">
          <view class="conclusion-k">玄空格局</view>
          <view class="conclusion-v" style="font-size:23rpx;line-height:34rpx;">{{pattern}}</view>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="card-title">黑金海报预览</view>
      <view class="canvas-frame">
        <canvas type="2d" id="posterCanvas" style="width:100%;height:900rpx;border-radius:16rpx;background:#0b0e15;display:block;"></canvas>
      </view>
      <view class="btn-row">
        <view class="btn btn-primary" bindtap="save">{{saved ? '✓ 已存相册' : '存入相册'}}</view>
        <view class="btn" bindtap="preview">查看大图</view>
      </view>
      <button class="btn" open-type="share" style="margin-top:14rpx;">分享给好友</button>
      <view class="footnote">海报含盘面、坐向、分金与玄空格局，底部带小程序名；分享卡片缩略图使用海报本身。</view>
    </view>
  </view>
</view>
