/* 六爻爻线：阳爻一整条、阴爻两段；动爻高亮 */
.yao-board {
  margin: 16rpx 0 8rpx;
}

.yao-row {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
}

.yao-moving {
  background: rgba(233, 216, 166, 0.08);
  border-radius: 8rpx;
}

.yao-name {
  width: 96rpx;
  font-size: 22rpx;
  color: #9aa6bd;
}

.yao-bar {
  flex: 1;
  display: flex;
  align-items: center;
  height: 26rpx;
}

.bar-solid {
  width: 100%;
  height: 14rpx;
  background: #e9d8a6;
  border-radius: 4rpx;
}

.bar-half {
  flex: 1;
  height: 14rpx;
  background: #e9d8a6;
  border-radius: 4rpx;
}

.bar-gap {
  width: 32rpx;
  height: 14rpx;
}

.yao-flag {
  width: 44rpx;
  text-align: right;
  font-size: 22rpx;
  color: #e88b8b;
}

/* 京房八宫六爻表 */
.yao-list { margin-top: 12rpx; }
.yao-line {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
  font-size: 22rpx;
  color: #9fb0cb;
}
.yao-pos { width: 70rpx; color: #c9a24a; }
.yao-gz { width: 160rpx; color: #e8e2d4; }
.yao-qin { width: 100rpx; }
.yao-shen { width: 90rpx; color: #7f8fa6; }