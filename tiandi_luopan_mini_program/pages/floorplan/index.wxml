<view class="screen">
  <view class="topbar">
    <view class="topbar-back" bindtap="back">←</view>
    <view class="topbar-title">户型九宫</view>
    <view class="topbar-right" bindtap="resetSample">重置</view>
  </view>

  <view class="body">
    <ctx-bar />
    <!-- ============ 结论看板 ============ -->
    <view class="conclusion">
      <view class="conclusion-eyebrow">此向 · 此宅 · 户型结论</view>
      <view class="conclusion-head">{{concSitFace}}</view>
      <view class="conclusion-sub">{{concArea}} · 坐向来源 {{orientationLabel}}</view>
      <view class="conclusion-grid">
        <view class="conclusion-cell">
          <view class="conclusion-k">九宫吉凶</view>
          <view class="conclusion-v">{{concAudit}}</view>
        </view>
        <view class="conclusion-cell">
          <view class="conclusion-k">立极</view>
          <view class="conclusion-v" style="font-size:22rpx;">{{concPivot}}</view>
        </view>
        <view class="conclusion-cell wide" wx:if="{{concMissing}}">
          <view class="conclusion-k">缺角</view>
          <view class="conclusion-v xiong" style="font-size:22rpx;line-height:34rpx;">{{concMissing}}</view>
        </view>
        <view class="conclusion-cell wide" wx:if="{{concPlan}}">
          <view class="conclusion-k">家人配房</view>
          <view class="conclusion-v ji" style="font-size:22rpx;line-height:34rpx;">{{concPlan}}</view>
        </view>
      </view>
      <view class="conclusion-note">{{orientationHint}}</view>
    </view>

    <view class="card">
      <picker mode="selector" range="{{mountainNames}}" value="{{sitIdx}}" bindchange="onSitChange">
        <view class="input-row">
          <label>坐山</label>
          <view class="input-box">{{sit}} 山 · {{face}} 向</view>
        </view>
      </picker>
      <view class="input-row">
        <label>宅宽（米）</label>
        <input class="input-box" type="digit" value="{{widthMeters}}" bindinput="onWidth" placeholder="如 12" />
      </view>
      <view class="row"><text class="row-k">坐向来源</text><text class="row-v"><text class="tag tag-ji">{{orientationLabel}}</text></text></view>
      <view class="footnote">{{orientationHint}}</view>
      <view class="row"><text class="row-k">建筑面积</text><text class="row-v">{{areaSqm}} ㎡（图形占比 {{area}}）</text></view>
      <view class="row"><text class="row-k">中宫立极</text><text class="row-v">{{centroidText}}</text></view>
      <picker mode="selector" range="{{templates}}" value="{{tmplIdx}}" bindchange="onTemplate">
        <view class="input-row">
          <label>户型模板</label>
          <view class="input-box">{{templates.length ? templates[tmplIdx] : '载入模板'}}</view>
        </view>
      </picker>
      <view class="card-sub">点选房间可改用途、调宽深或删除；宅宽填入后按比例换算实际面积。无扫描能力时，可先用模板铺底再微调。</view>
    </view>

    <view class="card">
      <view class="card-title">户型示意（上北下南{{showOverlay ? ' · 罗盘叠透' : ''}}）</view>
      <view
        id="planBox"
        bindtouchstart="onPlanTouchStart"
        bindtouchmove="onPlanTouchMove"
        style="position:relative;width:100%;height:620rpx;background:rgba(16,20,29,0.9);border:1rpx solid rgba(120,140,180,0.18);border-radius:12rpx;overflow:hidden;"
      >
        <image wx:if="{{bgImage}}" src="{{bgImage}}" mode="aspectFill" style="position:absolute;left:0;top:0;width:100%;height:100%;opacity:0.35;"></image>
        <view style="position:absolute;left:33.33%;top:0;width:1rpx;height:100%;background:rgba(120,140,180,0.22);"></view>
        <view style="position:absolute;left:66.66%;top:0;width:1rpx;height:100%;background:rgba(120,140,180,0.22);"></view>
        <view style="position:absolute;top:33.33%;left:0;height:1rpx;width:100%;background:rgba(120,140,180,0.22);"></view>
        <view style="position:absolute;top:66.66%;left:0;height:1rpx;width:100%;background:rgba(120,140,180,0.22);"></view>

        <!-- 罗盘叠透：八宫方位 + 坐向轴线 -->
        <view wx:if="{{showOverlay}}" style="position:absolute;left:0;top:0;width:100%;height:100%;opacity:{{overlayOpacity}};pointer-events:none;">
          <view style="position:absolute;left:14%;top:14%;width:72%;height:72%;border:1rpx solid rgba(233,216,166,0.28);border-radius:50%;"></view>
          <view style="position:absolute;left:50%;top:50%;width:72%;height:2rpx;background:linear-gradient(90deg,rgba(233,216,166,0.15),rgba(233,216,166,0.85));transform-origin:0 50%;{{overlayLineStyle}}"></view>
          <view wx:for="{{overlayMarks}}" wx:key="palace" style="position:absolute;{{item.style}}transform:translate(-50%,-50%);font-size:18rpx;color:{{item.color}};white-space:nowrap;">
            {{item.label}}{{item.missing ? '缺' : ''}}
          </view>
          <view style="position:absolute;left:50%;top:50%;width:10rpx;height:10rpx;margin-left:-5rpx;margin-top:-5rpx;border-radius:50%;background:#e9d8a6;opacity:0.75;"></view>
        </view>

        <view
          wx:for="{{rooms}}"
          wx:key="idx"
          data-idx="{{item.idx}}"
          catchtouchstart="onRoomTouchStart"
          catchtouchmove="onRoomTouchMove"
          catchtouchend="onRoomTouchEnd"
          catchtouchcancel="onRoomTouchEnd"
          bindtap="onRoomTap"
          style="{{item.style}}position:absolute;padding:6rpx;font-size:20rpx;border:1rpx solid rgba(140,160,200,0.35);background:{{item.level === 'xiong' ? 'rgba(190,80,80,0.16)' : (item.level === 'ji' ? 'rgba(90,160,120,0.16)' : 'rgba(90,110,150,0.12)')}};"
        >
          <view style="color:#e9d8a6;">{{item.name}}</view>
          <view style="color:#9aa6bd;">{{item.palaceName}} {{item.combo}}</view>
        </view>

        <!-- 门窗开口（手工录入）：门为金色短杠，窗为青色短杠 -->
        <view
          wx:for="{{openingDots}}"
          wx:key="key"
          style="position:absolute;{{item.style}}transform:translate(-50%,-50%);pointer-events:none;font-size:18rpx;color:{{item.isDoor ? '#e9d8a6' : '#7fd3d0'}};"
        >
          <view style="width:{{item.len}}rpx;height:6rpx;background:{{item.isDoor ? '#e9d8a6' : '#7fd3d0'}};border-radius:2rpx;"></view>
          <view style="font-size:16rpx;">{{item.glyph}}</view>
        </view>

        <!-- 中宫立极点 -->
        <view style="position:absolute;{{pivotStyle}}transform:translate(-50%,-50%);width:24rpx;height:24rpx;pointer-events:none;">
          <view style="position:absolute;left:50%;top:0;width:2rpx;height:24rpx;margin-left:-1rpx;background:#e74c3c;"></view>
          <view style="position:absolute;top:50%;left:0;height:2rpx;width:24rpx;margin-top:-1rpx;background:#e74c3c;"></view>
        </view>
      </view>

      <view style="display:flex;gap:16rpx;margin-top:16rpx;">
        <view class="btn" style="flex:1;" bindtap="addRoom">新增房间</view>
        <view class="btn" style="flex:1;" bindtap="chooseImage">{{bgImage ? '换底图' : '导入底图'}}</view>
        <view class="btn" style="flex:1;" bindtap="toggle3D">{{show3D ? '关闭 3D' : '3D 示意'}}</view>
      </view>
      <view style="display:flex;gap:16rpx;margin-top:12rpx;">
        <view class="btn" style="flex:1;{{dragPivot ? 'border-color:#e74c3c;color:#ff8b7a;' : ''}}" bindtap="toggleDragPivot">{{dragPivot ? '拖动中 · 点击结束' : '拖动中宫立极'}}</view>
        <view class="btn" style="flex:1;{{showOverlay ? 'border-color:#e9d8a6;color:#e9d8a6;' : ''}}" bindtap="toggleOverlay">{{showOverlay ? '关闭罗盘叠透' : '罗盘叠透'}}</view>
      </view>
      <view class="btn" wx:if="{{hasPivot}}" style="margin-top:12rpx;" bindtap="resetPivot">立极点复位到面积重心</view>
      <view class="btn" wx:if="{{bgImage}}" style="margin-top:12rpx;" bindtap="clearImage">移除底图</view>
      <view class="footnote">按住房间可直接拖动改位置（不会跳格、不会越出户型框），松手即重算九宫与吉凶；点按房间可改用途、调宽深或删除。罗盘叠透把八宫方位与坐向轴线压在平面上，便于看「某间落在何宫、坐向是否正对某墙」；缺角宫位以红色标注。</view>
    </view>

    <view class="card">
      <view class="card-title">门窗开口（{{openingCountText}}）</view>
      <view style="display:flex;gap:12rpx;">
        <picker mode="selector" range="{{openingRoomNames}}" value="{{openingRoomIdx}}" bindchange="onOpeningRoom" style="flex:1.4;">
          <view class="input-box">{{openingRoomNames.length ? openingRoomNames[openingRoomIdx] : '先录入房间'}}</view>
        </picker>
        <picker mode="selector" range="{{openingSides}}" value="{{openingSideIdx}}" bindchange="onOpeningSide" style="flex:1;">
          <view class="input-box">{{openingSides[openingSideIdx]}}</view>
        </picker>
        <picker mode="selector" range="{{openingTypes}}" value="{{openingTypeIdx}}" bindchange="onOpeningType" style="flex:0.7;">
          <view class="input-box">{{openingTypes[openingTypeIdx]}}</view>
        </picker>
      </view>
      <view style="display:flex;gap:12rpx;margin-top:12rpx;">
        <view class="btn" style="flex:1;" bindtap="addOpening">录入一扇</view>
        <view class="btn" style="flex:1;" bindtap="applyDoorFacing">按入户门判坐向</view>
        <view class="btn" style="flex:0.7;" bindtap="clearOpenings">清空</view>
      </view>
      <view wx:for="{{openingRows}}" wx:key="key" class="row" style="align-items:center;">
        <text class="row-k" style="flex:1;color:{{item.isDoor ? '#e9d8a6' : '#9aa6bd'}};">{{item.text}}</text>
        <text class="row-v" data-idx="{{item.idx}}" bindtap="removeOpening" style="color:#e88b8b;">删除</text>
      </view>
      <view class="footnote">{{doorHint}} 图示上北下南：北在上、东在右；门窗落在何宫随房间位置实时重算，并进入宅谱、DXF 与存证报告的清单。</view>
    </view>

    <view class="card" wx:if="{{show3D}}">
      <view class="card-title">3D 体块示意（可拖动旋转）</view>
      <canvas type="2d" id="isoCanvas" style="width:100%;height:520rpx;background:#0f1117;border-radius:12rpx;"
        bindtouchstart="onIsoTouchStart" bindtouchmove="onIsoTouchMove" bindtouchend="onIsoTouchEnd" bindtouchcancel="onIsoTouchEnd"></canvas>
      <view style="display:flex;gap:16rpx;margin-top:12rpx;">
        <view class="btn" style="flex:1;" bindtap="resetIso">复位视角</view>
      </view>
      <view class="footnote">小程序无 SceneKit / RealityKit，此处以 Canvas 等轴测投影绘制体块，横向拖动可绕户型中心旋转、纵向拖动可缩放，用于查看体量与相对位置，不做真实层高与材质渲染。</view>
    </view>

    <view class="fold-head">
      <text class="fold-label">详细审计（缺角 · 覆盖率 · 配房 · 存档 · 导出）</text>
      <text class="fold-toggle" bindtap="toggleDetail">{{showDetail ? '收起详情 ▲' : '展开详情 ▼'}}</text>
    </view>
    <view wx:if="{{showDetail}}" class="fold-body">
    <view class="card">
      <view class="card-title">全屋空间体检（iOS analyzeSpatialHouse 判据）</view>
      <view class="row">
        <view class="row-k">体检评分</view>
        <view class="row-v"><text class="tag {{spatialScore >= 80 ? 'tag-ji' : (spatialScore >= 60 ? 'tag-ping' : 'tag-xiong')}}">{{spatialScore}} 分</text></view>
      </view>
      <view class="list-item" wx:for="{{spatialItems}}" wx:key="title">
        <view class="list-main">
          <text>{{item.title}}</text>
          <text class="tag {{item.severity === 'critical' ? 'tag-xiong' : (item.severity === 'auspicious' ? 'tag-ji' : 'tag-ping')}}" style="margin-left:10rpx;">{{item.scoreDelta > 0 ? '+' : ''}}{{item.scoreDelta}}</text>
        </view>
        <view class="list-desc">{{item.locationName}} · {{item.detail}}</view>
        <view class="list-desc" style="color:#e8b06a;">化解：{{item.solution}}</view>
      </view>
      <view class="footnote">92 分起评，逐项加减（中宫受污 −16、火烧中宫 −14、穿堂 −15、门对门 −8、水火相邻 −7、狭长 −6、鲁班门 ±4/5）。3D 专属项（横梁压顶、尖角冲射等）需 RoomPlan 法向数据，小程序未纳入自动扣分，请现场核对。</view>
    </view>

    <view class="card" wx:if="{{spatialFindings.length}}">
      <view class="card-title">几何判煞要点</view>
      <view class="list-item" wx:for="{{spatialFindings}}" wx:key="text">
        <view class="list-desc" style="color:{{item.warn ? '#e88b8b' : '#c9d3e6'}};">{{item.text}}</view>
      </view>
    </view>

    <view class="card">
      <view class="card-title">多房源 PK 横向对比（iOS 评分口径）</view>
      <view class="list-item" wx:for="{{pkRows}}" wx:key="label">
        <view class="list-main">
          <text>{{item.label}} · {{item.sit}}山</text>
          <text class="tag {{item.score >= 80 ? 'tag-ji' : (item.score >= 60 ? 'tag-ping' : 'tag-xiong')}}">{{item.score}}分 {{item.level}}</text>
        </view>
        <view class="list-desc">{{item.match}} · {{item.formula}}</view>
      </view>
      <view class="footnote" wx:if="{{pkHint}}">{{pkHint}}</view>
    </view>

    <view class="card">
      <view class="card-title">缺角专项（{{missingCount}} 处缺角 · 带出处）</view>
      <view class="list-item" wx:for="{{missingAudits}}" wx:key="palace">
        <view class="list-main">
          <text>{{item.title}}</text>
          <text class="tag {{item.level === 'xiong' ? 'tag-xiong' : (item.level === 'ji' ? 'tag-ji' : 'tag-ping')}}">{{item.level === 'xiong' ? '缺角' : (item.level === 'ji' ? '完整' : '气偏')}}</text>
        </view>
        <view class="list-desc" wx:if="{{item.hurt}}" style="color:#e8a87c;">{{item.hurt}}</view>
        <view class="list-desc" wx:if="{{item.remedy}}">化解：{{item.remedy}}</view>
        <view class="list-desc" wx:if="{{item.source}}" style="color:#8f9bb3;font-size:20rpx;">{{item.source}}</view>
      </view>
      <view class="footnote" wx:if="{{missingCount === 0}}">本例九宫覆盖率均达 40% 以上，未判缺角；如实际宅形有凹凸，可缩小对应房间面积再看。</view>
    </view>

    <view class="card">
      <view class="card-title">九宫覆盖率（量化缺角）</view>
      <view class="list-item" wx:for="{{coverage}}" wx:key="palace">
        <view class="list-main">
          <text>{{item.name}} · {{item.dir}}</text>
          <text class="tag {{item.status === 'missing' ? 'tag-xiong' : (item.status === 'full' ? 'tag-ji' : 'tag-ping')}}">{{item.percent}}%</text>
        </view>
      <view class="list-desc">{{item.status === 'missing' ? '覆盖不足 40%，视作缺角' : (item.status === 'full' ? '本宫完整' : '部分覆盖，气略偏')}}</view>
      </view>
    </view>

    <view class="card">
      <view class="card-title">审计结论</view>
      <view class="row">
        <view class="row-k">吉 / 平 / 凶</view>
        <view class="row-v">{{counts.ji}} / {{counts.ping}} / {{counts.xiong}}</view>
      </view>
      <view class="list-item" wx:for="{{summary}}" wx:key="*this">
        <view class="list-desc" style="color:#dfe4ee;">{{item}}</view>
      </view>
    </view>

    <view class="card" wx:if="{{roomPlan}}">
      <view class="card-title">家人配房 · {{planMode === 'manual' ? '手定方案' : '系统推荐'}}</view>
      <view class="list-item" wx:for="{{planRows}}" wx:key="id">
        <view class="list-main">
          <text>{{item.name}}</text>
          <text class="tag tag-ping">{{item.gua}}</text>
        </view>
        <view class="list-desc" style="color:{{item.bedOk ? '#7fd3a0' : '#e8b06a'}};">卧房：{{item.bed}}</view>
        <view class="list-desc" style="color:{{item.studyOk ? '#7fd3a0' : '#8f9bb3'}};">书房：{{item.study}}</view>
      </view>
      <view class="list-item" wx:for="{{planReviews}}" wx:key="*this">
        <view class="list-desc" style="color:#e88b8b;">⚠︎ {{item}}</view>
      </view>
      <view class="list-desc" wx:if="{{planUnassigned.length}}" style="color:#e8b06a;">未配卧房：{{planUnassigned}}</view>
      <view class="footnote">按各房几何中心归八宅宫位排名：书房 伏位100 / 生气90 / 延年80 / 天医70，卧房 延年100 / 天医95 / 伏位80 / 生气75；只配吉星房，厨房、卫浴、客厅、储物不作卧室。含太极点的中宫房不参与排名。{{planHint}}</view>
    </view>

    <view class="card">
      <view class="card-title">逐间审计</view>
      <view class="list-item" wx:for="{{rooms}}" wx:key="idx">
        <view class="list-main">
          <text>{{item.name}} · {{item.type}}</text>
          <text class="tag tag-{{item.level === 'xiong' ? 'xiong' : (item.level === 'ji' ? 'ji' : 'ping')}}">{{item.palaceName}} 山{{item.shan}}向{{item.xiang}}</text>
        </view>
        <view class="list-desc">{{item.advice}}</view>
        <view class="list-desc" wx:if="{{item.notes.length}}">{{item.notes[0]}}</view>
      </view>
    </view>

    <view class="card">
      <view class="card-title">户型存档（{{plans.length}}）</view>
      <view class="btn" bindtap="savePlan">保存当前户型</view>
      <view style="display:flex;gap:16rpx;margin-top:12rpx;">
        <view class="btn" style="flex:1;" bindtap="loadPlan">载入存档</view>
        <view class="btn" style="flex:1;" bindtap="deletePlan">删除存档</view>
      </view>
      <view class="list-item" wx:for="{{plans}}" wx:key="id">
        <view class="list-main"><text>{{item.label}}</text></view>
      </view>
      <view class="footnote">存档写入本机 Storage，最多保留 20 条，卸载小程序即失效。</view>
    </view>

    <view class="card">
      <view class="card-title">宅谱导出 / 导入</view>
      <view style="display:flex;gap:16rpx;">
        <view class="btn" style="flex:1;" bindtap="exportJSON">导出宅谱 JSON</view>
        <view class="btn" style="flex:1;" bindtap="exportDXF">导出 DXF 图纸</view>
      </view>
      <view class="btn" style="margin-top:12rpx;" bindtap="importJSON">导入宅谱 JSON</view>
      <view class="btn" style="margin-top:12rpx;" bindtap="goReport">生成空间测绘报告图</view>
      <view class="footnote">
        宅谱 JSON 含坐向、宅宽、房间与立极点，可跨设备/跨人交接；DXF 为 AutoCAD R12 ASCII，按宅宽换算为毫米（1 坐标单位 = 宅宽/100 米），可直接用 CAD 或酷家乐打开。
      </view>
    </view>
    </view>

    <view class="footnote">
      小程序无法调用 LiDAR / RoomPlan 做自动量房，故改为手工录入 + 底图描摹 + 九宫覆盖率；几何算法（重心、缺角、面积、体块投影）与 iOS 同源。
    </view>
  </view>

  <!-- 房间风水体检详勘弹层（对齐 iOS RoomAuditDetailSheet） -->
  <view class="modal-mask" wx:if="{{showRoomDetail}}" bindtap="closeRoomDetail">
    <view class="modal" catchtap="noop">
      <view class="modal-header">
        <text class="modal-title">{{roomDetail.name}} · 房间体检</text>
        <text class="modal-close" bindtap="closeRoomDetail">✕</text>
      </view>
      <block wx:if="{{roomDetail.audit}}">
        <view class="conclusion" style="margin-bottom:16rpx;">
          <view class="conclusion-eyebrow">九宫归属</view>
          <view class="conclusion-head">{{roomDetail.audit.palaceName}}宫 · {{roomDetail.audit.dir}} · {{roomDetail.audit.combo}}</view>
          <view class="conclusion-sub">{{roomDetail.type}} · {{roomDetail.areaText}} · 山{{roomDetail.audit.shan}}向{{roomDetail.audit.xiang}}</view>
          <view class="conclusion-grid">
            <view class="conclusion-cell">
              <view class="conclusion-k">吉凶等级</view>
              <view class="conclusion-v {{roomDetail.audit.level === 'xiong' ? 'xiong' : (roomDetail.audit.level === 'ji' ? 'ji' : '')}}">{{roomDetail.audit.level === 'xiong' ? '凶' : (roomDetail.audit.level === 'ji' ? '吉' : '平')}} · {{roomDetail.audit.score}}</view>
            </view>
            <view class="conclusion-cell">
              <view class="conclusion-k">跨宫</view>
              <view class="conclusion-v" style="font-size:22rpx;">{{roomDetail.audit.palaces.length}} 宫</view>
            </view>
          </view>
          <view class="conclusion-note">{{roomDetail.audit.advice}}</view>
        </view>
        <view class="list-item" wx:for="{{roomDetail.audit.notes}}" wx:key="*this">
          <view class="list-desc">· {{item}}</view>
        </view>
      </block>
      <view class="footnote" wx:if="{{!roomDetail.audit}}">该房间尚未纳入九宫审计，请确认房间矩形有效。</view>
      <view class="btn" style="margin-top:16rpx;" bindtap="editRoomFromDetail">改用途 / 尺寸 / 删除</view>
    </view>
  </view>
</view>
