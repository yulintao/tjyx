/* 四格上下文条：方位 / 位置 / 时令 / 生辰，一屏可读、可点 */
.ctx-bar {
  display: flex;
  flex-wrap: wrap;
  width: 100%;
  margin: 0 0 18rpx;
  padding: 10rpx 8rpx;
  background: linear-gradient(180deg, rgba(24, 31, 46, 0.92) 0%, rgba(15, 20, 31, 0.94) 100%);
  border: 1rpx solid rgba(212, 175, 55, 0.24);
  border-radius: 18rpx;
  box-shadow: 0 8rpx 22rpx rgba(0, 0, 0, 0.35), inset 0 1rpx 0 rgba(255, 236, 184, 0.1);
  box-sizing: border-box;
}

.ctx-cell {
  width: 50%;
  padding: 10rpx 16rpx;
  box-sizing: border-box;
  border-radius: 12rpx;
  transition: background 0.15s ease;
}

.ctx-cell-hover {
  background: rgba(233, 216, 166, 0.08);
}

.ctx-k {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 19rpx;
  color: #8b98b2;
  letter-spacing: 1rpx;
}

.ctx-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  display: inline-block;
  flex-shrink: 0;
}

.dot-gold {
  background: #e9d8a6;
  box-shadow: 0 0 8rpx rgba(233, 216, 166, 0.55);
}

.dot-cyan {
  background: #5eead4;
  box-shadow: 0 0 8rpx rgba(94, 234, 212, 0.55);
}

.dot-dim {
  background: #55617a;
}

.ctx-v {
  margin-top: 6rpx;
  padding-left: 18rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #f2dfb0;
  line-height: 32rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.ctx-3 .ctx-cell {
  width: 33.33%;
  padding: 8rpx 10rpx;
  border-right: 1rpx solid rgba(130, 152, 196, 0.1);
}

.ctx-3 .ctx-cell:last-child {
  border-right: none;
}

.ctx-dim {
  color: #8b98b2;
  font-weight: 400;
}
