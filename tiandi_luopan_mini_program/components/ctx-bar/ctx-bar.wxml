<view class="ctx-bar {{hideDir ? 'ctx-3' : ''}}">
  <view class="ctx-cell" hover-class="ctx-cell-hover" wx:if="{{!hideDir}}" bindtap="onDirTap">
    <view class="ctx-k"><text class="ctx-dot dot-gold"></text><text>当前方位</text></view>
    <view class="ctx-v">{{sitFace || '未测向'}}</view>
  </view>
  <view class="ctx-cell" hover-class="ctx-cell-hover" bindtap="onPlaceTap" bindlongpress="onPlaceName">
    <view class="ctx-k"><text class="ctx-dot {{hasPlace ? 'dot-cyan' : 'dot-dim'}}"></text><text>所处位置</text></view>
    <view class="ctx-v {{hasPlace ? '' : 'ctx-dim'}}">{{refreshing ? '定位中…' : place}}</view>
  </view>
  <view class="ctx-cell" hover-class="ctx-cell-hover" bindtap="onTermTap">
    <view class="ctx-k"><text class="ctx-dot dot-gold"></text><text>时令</text></view>
    <view class="ctx-v">{{term}}</view>
  </view>
  <view class="ctx-cell" hover-class="ctx-cell-hover" bindtap="onPersonTap">
    <view class="ctx-k"><text class="ctx-dot {{hasPerson ? 'dot-cyan' : 'dot-dim'}}"></text><text>本人生辰</text></view>
    <view class="ctx-v {{hasPerson ? '' : 'ctx-dim'}}">{{person}}</view>
  </view>
</view>
