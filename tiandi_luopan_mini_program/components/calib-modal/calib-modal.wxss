/* components/calib-modal/calib-modal.wxss */

/* 校准弹窗模态框 */
.calib-modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(5, 7, 12, 0.8);
  backdrop-filter: blur(10rpx);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
}

.calib-card {
  background: linear-gradient(168deg, #222638 0%, #151722 100%);
  border: 1rpx solid rgba(233, 216, 166, 0.3);
  border-radius: 28rpx;
  width: 90vw;
  max-width: 640rpx;
  padding: 36rpx;
  box-shadow: 0 24rpx 68rpx rgba(0, 0, 0, 0.85), inset 0 1rpx 0 rgba(255, 236, 184, 0.14);
}

.calib-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(233, 216, 166, 0.14);
}

.calib-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #f2dfb0;
  letter-spacing: 1rpx;
}

.calib-close {
  font-size: 32rpx;
  color: #93a1ba;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.05);
}

.calib-status-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 25rpx;
  color: #cdd5e5;
  margin-bottom: 16rpx;
}

.calib-acc-badge {
  font-weight: 600;
  font-size: 22rpx;
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(46, 204, 113, 0.16);
  border: 1rpx solid rgba(46, 204, 113, 0.4);
  color: #6ee7b7;
}

.calib-acc-badge.med {
  background: rgba(243, 156, 18, 0.16);
  border-color: rgba(243, 156, 18, 0.4);
  color: #fbbf24;
}

.calib-acc-badge.low {
  background: rgba(231, 76, 60, 0.18);
  border-color: rgba(231, 76, 60, 0.45);
  color: #f87171;
}

.calib-decl-badge {
  font-weight: 600;
  font-size: 24rpx;
}

.calib-figure8-box {
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
  background: rgba(11, 14, 22, 0.72);
  border: 1rpx solid rgba(130, 152, 196, 0.18);
  border-radius: 20rpx;
  padding: 22rpx;
  margin-bottom: 18rpx;
}

.figure8-icon {
  font-size: 46rpx;
  color: #e9d8a6;
  flex-shrink: 0;
  line-height: 1.2;
}

.calib-figure8-text {
  font-size: 23rpx;
  color: #aeb8cc;
  line-height: 1.6;
}

.bold-text {
  font-weight: 600;
  color: #f3e4b8;
}

.calib-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 26rpx;
}

.calib-btn {
  flex: 1;
  background: linear-gradient(135deg, #e2c16b 0%, #b58d34 100%);
  color: #16181f;
  font-weight: 700;
  border-radius: 16rpx;
  padding: 18rpx 0;
  font-size: 26rpx;
  line-height: 1.4;
  border: none;
  box-shadow: 0 8rpx 20rpx rgba(201, 162, 74, 0.28);
}

.calib-btn::after,
.calib-btn-sub::after {
  border: none;
}

.calib-btn-sub {
  background: rgba(45, 54, 74, 0.7);
  border: 1rpx solid rgba(130, 152, 196, 0.24);
  color: #d7deec;
  border-radius: 16rpx;
  padding: 18rpx 28rpx;
  font-size: 26rpx;
  line-height: 1.4;
}
